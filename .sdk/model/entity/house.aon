# Entity: house

main: kit: entity: house: {

  alias: field: {}

  fields: [
    {
      name: "ancestralWeapons"
      req: false
      short: "An array of names of the ancestral weapons of this house"
      type: "`$ARRAY`"
    }
    {
      name: "cadetBranches"
      req: false
      short: "An array of house resource URLs that was founded from this house"
      type: "`$ARRAY`"
    }
    {
      name: "coatOfArms"
      req: false
      short: "Text describing the coat of arms of this house"
      type: "`$STRING`"
    }
    {
      name: "currentLord"
      req: false
      short: "The character resource URL of this house's current lord"
      type: "`$STRING`"
    }
    {
      name: "diedOut"
      req: false
      short: "The year that this house died out"
      type: "`$STRING`"
    }
    {
      name: "founded"
      req: false
      short: "The year that this house was founded"
      type: "`$STRING`"
    }
    {
      name: "founder"
      req: false
      short: "The character resource URL that founded this house"
      type: "`$STRING`"
    }
    {
      name: "heir"
      req: false
      short: "The character resource URL of this house's heir"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "The name of this house"
      type: "`$STRING`"
    }
    {
      name: "overlord"
      req: false
      short: "The house resource URL that this house answers to"
      type: "`$STRING`"
    }
    {
      name: "region"
      req: false
      short: "The region that this house resides in"
      type: "`$STRING`"
    }
    {
      name: "seats"
      req: false
      short: "The seats that this house holds"
      type: "`$ARRAY`"
    }
    {
      name: "swornMembers"
      req: false
      short: "An array of character resource URLs that are sworn to this house"
      type: "`$ARRAY`"
    }
    {
      name: "titles"
      req: false
      short: "The titles that this house holds"
      type: "`$ARRAY`"
    }
    {
      name: "url"
      req: false
      short: "The hypermedia URL of this resource"
      type: "`$STRING`"
    }
    {
      name: "words"
      req: false
      short: "The words of this house"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "house"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "name"
                orig: "name"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 10
                kind: "query"
                name: "page_size"
                orig: "page_size"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "region"
                orig: "region"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/houses"
          parts: [
            "houses"
          ]
          select: {
            exist: [
              "name"
              "page"
              "page_size"
              "region"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/houses/{id}"
          parts: [
            "houses"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
